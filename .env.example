# CrossTune build-time configuration.
# Copy to .env and fill in locally. In Docker/Railway these are passed as
# build args (see Dockerfile / README). Both values are compiled into the
# public JS bundle — a Spotify Client ID is NOT a secret (PKCE flow), but
# NEVER put a client secret in a client-side app.

# Spotify Client ID from https://developer.spotify.com/dashboard (free)
VITE_SPOTIFY_CLIENT_ID=

# Apple Music developer token (optional / coming soon)
VITE_APPLE_MUSIC_TOKEN=
